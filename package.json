{
  "name": "keydrop",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx concurrently \"npm run dev:web\" \"npm run dev:admin\"",
    "dev:web": "npm run dev --workspace @keydrop/web",
    "dev:admin": "npm run dev --workspace @keydrop/admin",
    "build": "npm run build:web && npm run build:admin",
    "build:web": "npm run build --workspace @keydrop/web",
    "build:admin": "npm run build --workspace @keydrop/admin",
    "start:web": "npm run start --workspace @keydrop/web",
    "start:admin": "npm run start --workspace @keydrop/admin",
    "lint": "eslint apps packages"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
